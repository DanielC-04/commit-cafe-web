---
/*
  El estudio en ilustración (spec 7.1, capa 1).

  Versión plana de la habitación del boceto 3D, dibujada en SVG con la
  paleta de marca. Es lo primero que se ve en la columna fija de TODAS las
  páginas. En la fase 1b, la escena 3D la reemplazará cuando el navegador
  pueda; si no, esta ilustración se queda.

  - Cada objeto es una sección y solo aparece si tiene contenido
    (estante = Taller, caja = Roturas).
  - `foco` resalta el objeto de la página actual con un subrayado naranja.
  - El vapor se mueve con CSS, solo si no se pidió reducir el movimiento.
  - Es decorativa (aria-hidden): la navegación real son los enlaces HTML.
*/
export type Foco = "general" | "monitor" | "estante" | "caja" | "taza";

interface Props {
  foco?: Foco;
  /** Cuántos proyectos hay (un libro por proyecto, máximo 12 dibujados). */
  proyectos?: number;
  /** Si hay al menos una rotura publicada. */
  roturas?: boolean;
  /** Para la 404: la taza aparece volcada. */
  tazaVolcada?: boolean;
}

const {
  foco = "general",
  proyectos = 0,
  roturas = false,
  tazaVolcada = false,
} = Astro.props;

const libros = Array.from({ length: Math.min(proyectos, 12) }, (_, i) => i);
const coloresLibro = ["var(--crema)", "var(--crema-apagada)", "var(--naranja)"];
---

<svg
  class="estudio"
  data-foco={foco}
  viewBox="0 0 400 300"
  aria-hidden="true"
  focusable="false"
>
  <!-- Pared y suelo -->
  <rect width="400" height="300" fill="var(--carbon)"></rect>
  <rect width="400" height="214" fill="var(--carbon-alto)"></rect>

  <!-- Ventana con luna (fase 3: "Mi historia") -->
  <g class="obj">
    <rect
      x="28"
      y="30"
      width="92"
      height="70"
      rx="3"
      fill="var(--carbon)"
    ></rect>
    <line
      x1="74"
      y1="30"
      x2="74"
      y2="100"
      stroke="var(--carbon-alto)"
      stroke-width="3"
    ></line>
    <circle cx="100" cy="48" r="8" fill="var(--crema)"></circle>
  </g>

  <!-- Estante: Taller. Un libro por proyecto. -->
  {proyectos > 0 && (
    <g class="obj obj--estante">
      <rect x="286" y="78" width="90" height="4" fill="var(--crema-apagada)" />
      {libros.map((i) => (
        <rect
          x={290 + i * 7}
          y={i % 3 === 1 ? 56 : 52}
          width="5.5"
          height={i % 3 === 1 ? 22 : 26}
          rx="1"
          fill={coloresLibro[i % 3]}
        />
      ))}
      <line class="marca" x1="286" y1="88" x2="376" y2="88" />
    </g>
  )}

  <!-- Lámpara -->
  <g class="obj">
    <rect
      x="58"
      y="196"
      width="26"
      height="4"
      rx="2"
      fill="var(--carbon)"
    ></rect>
    <rect x="69" y="150" width="3" height="46" fill="var(--carbon)"></rect>
    <path d="M52 150 L89 150 L80 132 L61 132 Z" fill="var(--naranja)"></path>
  </g>

  <!-- Escritorio -->
  <rect
    x="34"
    y="200"
    width="332"
    height="7"
    rx="2"
    fill="var(--crema-apagada)"
  ></rect>
  <rect x="48" y="207" width="6" height="62" fill="var(--carbon-alto)"></rect>
  <rect x="346" y="207" width="6" height="62" fill="var(--carbon-alto)"></rect>

  <!-- Monitor: el Log -->
  <g class="obj obj--monitor">
    <rect
      x="128"
      y="98"
      width="144"
      height="88"
      rx="5"
      fill="var(--carbon)"
    ></rect>
    <rect
      x="135"
      y="105"
      width="130"
      height="74"
      rx="2"
      fill="var(--carbon-alto)"
    ></rect>
    <!-- Filas del log: hash + título -->
    <rect
      x="143"
      y="114"
      width="36"
      height="5"
      rx="2"
      fill="var(--crema)"
    ></rect>
    <circle cx="146" cy="128" r="2" fill="var(--naranja)"></circle>
    {[0, 1, 2].map((i) => (
      <g>
        <rect
          x="143"
          y={140 + i * 12}
          width="14"
          height="4"
          rx="1"
          fill="var(--crema-apagada)"
        />
        <rect
          x="162"
          y={140 + i * 12}
          width={90 - i * 18}
          height="4"
          rx="1"
          fill="var(--crema)"
        />
      </g>
    ))}
    <rect x="194" y="186" width="12" height="10" fill="var(--carbon)"></rect>
    <rect
      x="178"
      y="195"
      width="44"
      height="5"
      rx="2"
      fill="var(--carbon)"
    ></rect>
    <line class="marca" x1="128" y1="192" x2="272" y2="192"></line>
  </g>

  <!-- Caja de roturas -->
  {roturas && (
    <g class="obj obj--caja">
      <rect
        x="300"
        y="250"
        width="44"
        height="30"
        rx="2"
        fill="var(--crema-apagada)"
      />
      <path
        d="M300 250 L322 240 L344 250"
        fill="none"
        stroke="var(--crema)"
        stroke-width="3"
      />
      <path
        d="M312 262 l6 6 l-6 6 M330 262 l-6 6 l6 6"
        stroke="var(--carbon)"
        stroke-width="3"
        fill="none"
      />
      <line class="marca" x1="300" y1="288" x2="344" y2="288" />
    </g>
  )}

  <!-- Taza: "Ahora" -->
  <g class:list={["obj obj--taza", { volcada: tazaVolcada }]}>
    <g class="vapor-grupo">
      <path class="vapor v1" d="M296 160 c-5 -6 5 -10 0 -18"></path>
      <path class="vapor v2" d="M306 158 c-6 -7 6 -12 0 -22"></path>
      <path class="vapor v3" d="M316 160 c-5 -6 5 -10 0 -18"></path>
    </g>
    <path
      d="M290 168 h34 v14 c0 10 -7 18 -17 18 s-17 -8 -17 -18 z"
      fill="var(--crema)"
    ></path>
    <path
      d="M324 173 h4 a6 6 0 0 1 0 12 h-5"
      fill="none"
      stroke="var(--crema)"
      stroke-width="4"
    ></path>
    {tazaVolcada && (
      <path
        d="M318 200 q30 4 52 0"
        stroke="var(--crema-apagada)"
        stroke-width="4"
        fill="none"
        stroke-linecap="round"
      />
    )}
  </g>
</svg>

<style>
  .estudio {
    /* El tamaño lo decide quien la usa (DeskColumn). */
    display: block;
    border-radius: var(--radio);
  }

  /* Subrayado naranja bajo el objeto de la página actual. */
  .marca {
    stroke: var(--naranja);
    stroke-width: 3;
    stroke-linecap: round;
    opacity: 0;
  }
  [data-foco="monitor"] .obj--monitor .marca,
  [data-foco="estante"] .obj--estante .marca,
  [data-foco="caja"] .obj--caja .marca {
    opacity: 1;
  }

  .vapor {
    fill: none;
    stroke: var(--naranja);
    stroke-width: 3;
    stroke-linecap: round;
  }

  /* La taza volcada de la 404. */
  .volcada {
    transform-box: fill-box;
    transform-origin: 50% 100%;
    rotate: 70deg;
    translate: 6px 0;
  }
  .volcada .vapor-grupo {
    display: none;
  }

  /* Estático por defecto; el vapor sube solo si se acepta movimiento. */
  @media (prefers-reduced-motion: no-preference) {
    .vapor {
      animation: subir 3.2s ease-in-out infinite;
    }
    .v2 {
      animation-delay: -1.1s;
    }
    .v3 {
      animation-delay: -2.2s;
    }
  }

  @keyframes subir {
    0% {
      translate: 0 4px;
      opacity: 0.3;
    }
    50% {
      opacity: 1;
    }
    100% {
      translate: 0 -4px;
      opacity: 0.3;
    }
  }
</style>
