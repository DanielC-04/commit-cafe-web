---
/*
  La "taza viva": el único momento memorable del sitio (spec 7).
  Usa el icono oficial del kit sin tocar la forma del "&". Solo el vapor
  (el trazo naranja) se mueve, y únicamente si la persona no pidió
  reducir el movimiento en su sistema.

  Todo pasa en el build: leemos el SVG como texto y separamos las 3
  volutas de vapor en 3 trazos para animarlas por separado. En el
  navegador no se ejecuta JavaScript.
*/
import iconoSvg from "../../public/brand/icono.svg?raw";

interface Props {
  /** Tamaño en px (ancho y alto). */
  size?: number;
  /** Texto alternativo. Vacío si la taza es decorativa. */
  label?: string;
}

const { size = 160, label = "" } = Astro.props;

const NARANJA = 'fill="#E8913F"';
const svg = iconoSvg
  .replace(/^<svg[^>]*>/, "")
  .replace("</svg>", "")
  .replace(
    /<path([^>]*?)d="([^"]*)"([^>]*?)\/>/g,
    (match, antes, d, despues) => {
      if (!(antes + despues).includes(NARANJA)) return match;
      // Cada "M" empieza una voluta nueva.
      return d
        .split(/(?=M)/)
        .map(
          (voluta: string, i: number) =>
            `<path class="vapor vapor-${i + 1}"${antes}d="${voluta}"${despues}/>`,
        )
        .join("");
    },
  );
---

<svg
  class="taza"
  viewBox="0 0 1024 1024"
  width={size}
  height={size}
  role={label ? "img" : undefined}
  aria-label={label || undefined}
  aria-hidden={label ? undefined : "true"}
  set:html={svg}
/>

<style>
  .taza {
    inline-size: var(--taza-size, auto);
  }

  /* Por defecto el vapor está quieto. Solo se anima si el sistema no pide
     movimiento reducido (guía "motion" de modern-web-guidance). */
  @media (prefers-reduced-motion: no-preference) {
    .taza :global(.vapor) {
      transform-box: fill-box;
      transform-origin: 50% 100%;
      animation: vapor 3.6s ease-in-out infinite;
    }
    .taza :global(.vapor-2) {
      animation-delay: -1.2s;
    }
    .taza :global(.vapor-3) {
      animation-delay: -2.4s;
    }
  }

  @keyframes vapor {
    0%,
    100% {
      translate: 0 0;
      scale: 1 1;
      opacity: 1;
    }
    50% {
      translate: 0 -3%;
      scale: 0.96 1.06;
      opacity: 0.75;
    }
  }
</style>
