---
/*
  BaseLayout: el esqueleto HTML de TODAS las páginas.
  Se ocupa del <head> (SEO, fuentes, favicon) y del "skip link".
  Las páginas no escriben <html>, <head> ni <body>: usan este layout.
*/
import { Font } from "astro:assets";
import "../styles/base.css"; // primero: declara el orden de las capas
import "../styles/tokens.css";

interface Props {
  /** Título de la página (sin el nombre del sitio). */
  title: string;
  /** Descripción única para buscadores y redes (≤ 160 caracteres). */
  description: string;
  /** Imagen para redes sociales. Por defecto, la de marca. */
  ogImage?: string;
  /** true para páginas que no deben aparecer en buscadores. */
  noindex?: boolean;
  /** Datos estructurados (schema.org) para buscadores. */
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description,
  ogImage = "/brand/og-default.png",
  noindex = false,
  jsonLd,
} = Astro.props;

const SITE_NAME = "Commit&Cafe";
const fullTitle = title === SITE_NAME ? title : `${title} · ${SITE_NAME}`;
// Con build.format "file" Astro ve rutas como /index.html o /estudio.html,
// pero la URL pública limpia es / o /estudio (Netlify sirve ambas).
const cleanPath = Astro.url.pathname.replace(/(index)?\.html$/, "");
const canonical = new URL(cleanPath, Astro.site);
const ogUrl = new URL(ogImage, Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#1B1D1C" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    {jsonLd && (
      <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(jsonLd)}
      />
    )}

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/brand/icono.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Solo se precargan las fuentes que se ven al abrir la página. -->
    <Font cssVariable="--font-outfit" preload />
    <Font cssVariable="--font-figtree" preload />
    <Font cssVariable="--font-jetbrains" />

    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#contenido">
      Saltar al contenido
    </a>
    <slot />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    inset-block-start: var(--espacio-2);
    inset-inline-start: var(--espacio-2);
    z-index: 10;
    padding: var(--espacio-3) var(--espacio-4);
    background: var(--crema);
    color: var(--carbon);
    font-weight: 600;
    border-radius: var(--radio);
    translate: 0 -200%;
  }
  .skip-link:focus-visible {
    translate: 0 0;
    outline-color: var(--naranja);
  }
</style>
