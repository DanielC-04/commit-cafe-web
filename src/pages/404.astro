---
/* 404 útil: dice qué pasó y ofrece salidas (spec 6). En el estudio, la taza se volcó. */
import DeskLayout from "../layouts/DeskLayout.astro";
---

<DeskLayout
  title="Página no encontrada"
  description="Esta página no existe o cambió de dirección."
  noindex
  tazaVolcada
>
  <p class="codigo">
    <code>error: pathspec did not match any file(s)</code>
  </p>
  <h1>Esta página no existe</h1>
  <p class="texto">
    Puede que la dirección tenga un error o que el contenido se haya movido. Se
    nos volcó el café, pero el resto del estudio sigue en su sitio.
  </p>
  <ul class="salidas" role="list">
    <li>
      <a href="/">Volver al inicio</a>
    </li>
    <li>
      <a href="/estudio">Conocer el estudio</a>
    </li>
  </ul>
</DeskLayout>

<style>
  .codigo {
    color: var(--texto-suave);
    margin-block-end: var(--espacio-4);
  }
  .texto {
    margin-block: var(--espacio-4) var(--espacio-6);
    color: var(--texto-suave);
  }
  .salidas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espacio-6);
    padding: 0;
    list-style: none;
    font-weight: 500;
  }
</style>
