---
/* 404 útil: dice qué pasó y ofrece una salida (spec 6). */
import BaseLayout from "../layouts/BaseLayout.astro";
import TazaViva from "../components/TazaViva.astro";
---

<BaseLayout
  title="Página no encontrada"
  description="Esta página no existe o cambió de dirección."
  noindex
>
  <main id="contenido" class="error">
    <TazaViva size={96} />
    <p class="codigo">
      <code>error: pathspec did not match any file(s)</code>
    </p>
    <h1>Esta página no existe</h1>
    <p>
      Puede que la dirección tenga un error o que el contenido se haya movido.
    </p>
    <p>
      <a href="/">Volver al inicio</a>
    </p>
  </main>
</BaseLayout>

<style>
  .error {
    display: grid;
    justify-items: start;
    gap: var(--espacio-4);
    max-inline-size: 40rem;
    margin-inline: auto;
    padding: var(--espacio-16) var(--espacio-4);
  }
  .codigo {
    color: var(--texto-suave);
  }
</style>
