---
/*
  /estudio — contenido personal desde src/content/estudio.json, editable en el panel.
*/
import { getEntry } from "astro:content";
import DeskLayout from "../layouts/DeskLayout.astro";
import { POR_COMPLETAR } from "../site";

const estudio = await getEntry("estudio", "estudio");
// Si falta el archivo, mejor que el build falle con un mensaje claro.
if (!estudio) throw new Error("Falta src/content/estudio.json");
const { data } = estudio;
const parrafos = data.presentacion
  ?.split(/\n\s*\n/)
  .filter((parrafo) => parrafo.trim());
---

<DeskLayout
  title="Estudio"
  description="Quién está detrás de Commit&Cafe, con qué trabaja y cómo se hace cada video."
  foco="general"
>
  <div class="prosa">
    <h1>El estudio</h1>
    <p>
      Commit&Cafe es un canal en español sobre desarrollo de software, contado
      desde adentro: lo que se construye, lo que se rompe y lo que se aprende en
      el camino. Esta web es su mesa de trabajo y crece con cada commit.
    </p>

    <h2>Quién soy</h2>
    {data.nombre || parrafos?.length ? (
      <>
        {data.nombre && <p>Soy {data.nombre}.</p>}
        {parrafos?.map((parrafo) => (
          <p>{parrafo}</p>
        ))}
      </>
    ) : (
      <p class="pendiente">
        {POR_COMPLETAR}: presentación en dos o tres frases.
      </p>
    )}

    <h2>Setup</h2>
    {data.setup.length ? (
      <ul>
        {data.setup.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    ) : (
      <p class="pendiente">
        {POR_COMPLETAR}: equipo, monitor, micrófono, cámara.
      </p>
    )}

    <h2>Herramientas</h2>
    {data.herramientas.length ? (
      <ul>
        {data.herramientas.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    ) : (
      <p class="pendiente">
        {POR_COMPLETAR}: editor, terminal, lenguajes y apps del día a día.
      </p>
    )}

    <h2>Cómo hago un video</h2>
    {data.proceso.length ? (
      <ol>
        {data.proceso.map((paso) => (
          <li>{paso}</li>
        ))}
      </ol>
    ) : (
      <p class="pendiente">
        {POR_COMPLETAR}: de la idea al video publicado, paso a paso.
      </p>
    )}
  </div>
</DeskLayout>
