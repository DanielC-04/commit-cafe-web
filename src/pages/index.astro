---
/*
  Inicio (boceto-web.html, "Inicio escritorio").
  Columna fija con el estudio + "Lo último en el estudio" + vistas previas
  de las secciones que tienen contenido.
*/
import { getCollection } from "astro:content";
import DeskLayout from "../layouts/DeskLayout.astro";
import LogList from "../components/LogList.astro";
import KindFilters from "../components/KindFilters.astro";
import { getLog, facets, isPublished } from "../lib/log";
import { SITE } from "../site";

const ULTIMAS = 8;
const [log, projects] = await Promise.all([
  getLog(),
  getCollection("projects", isPublished),
]);
const { kinds } = facets(log);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: SITE.name,
  url: Astro.site?.href,
  inLanguage: SITE.locale,
  description: SITE.description,
  ...(SITE.author && {
    author: {
      "@type": "Person",
      name: SITE.author,
      sameAs: Object.values(SITE.social).filter(Boolean),
    },
  }),
};
---

<DeskLayout
  title={SITE.name}
  description={SITE.description}
  home
  jsonLd={jsonLd}
>
  <section>
    <h2 id="t-ultimo" class="titulo-seccion">
      Lo último en el estudio
    </h2>
    <KindFilters kinds={kinds} />
    <LogList entries={log.slice(0, ULTIMAS)} level={3} />
    {log.length > ULTIMAS && (
      <p class="mas">
        <a href="/log">Ver todo el log</a>
      </p>
    )}
  </section>

  {projects.length > 0 && (
    <section class="tarjeta">
      <h2 id="t-taller">Taller</h2>
      <p>
        Proyectos contados como relato: por qué, qué se rompió y qué aprendí.
      </p>
      <a href="/taller">Ver proyectos</a>
    </section>
  )}
</DeskLayout>

<style>
  .titulo-seccion {
    margin-block-end: var(--espacio-4);
  }
  .mas {
    padding-block-start: var(--espacio-6);
    border-block-start: 1px solid var(--superficie);
    font-weight: 500;
  }
  .tarjeta {
    margin-block-start: var(--espacio-12);
    padding: var(--espacio-8);
    background: var(--superficie);
    border-radius: var(--radio);
    display: grid;
    gap: var(--espacio-2);
    justify-items: start;
  }
  .tarjeta h2 {
    font-size: var(--titulo-3);
  }
  .tarjeta p {
    color: var(--texto-suave);
    margin-block-end: var(--espacio-2);
  }
  .tarjeta a {
    font-weight: 500;
  }
</style>
